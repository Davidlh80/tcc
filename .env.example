# Credenciais locais apenas para LocalStack. Nao use credenciais reais aqui.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Endpoint opcional para ferramentas que suportam AWS_ENDPOINT_URL.
AWS_ENDPOINT_URL=http://localhost:4566

# Variaveis Terraform podem ser adicionadas neste formato:
# TF_VAR_nome_da_variavel=valor

# scripts/generate-blueprint chama o Claude Code CLI (binario "claude") via
# subprocesso, usando a sessao/login ja autenticado (assinatura Claude Pro/Max/
# Team), sem consumir credito de API. Rode "claude /login" uma vez no terminal
# antes de gerar; nenhuma variavel de ambiente e necessaria aqui para isso.
