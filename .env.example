# Credenciais locais apenas para LocalStack. Nao use credenciais reais aqui.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Endpoint opcional para ferramentas que suportam AWS_ENDPOINT_URL.
AWS_ENDPOINT_URL=http://localhost:4566

# Variaveis Terraform podem ser adicionadas neste formato:
# TF_VAR_nome_da_variavel=valor

# Token da OpenAI, necessario apenas para scripts/generate-blueprint.
# Nunca commite uma chave real: copie este arquivo para .env e preencha localmente.
OPENAI_API_KEY=sk-proj-substitua-pela-sua-chave
